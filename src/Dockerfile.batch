# DOA Batch Jobs — On-Prem Dockerfile  
# ⚠️ Same anti-patterns as the web app Dockerfile

FROM mcr.microsoft.com/dotnet/sdk:8.0
WORKDIR /src
COPY . .
RUN dotnet publish DOA.BatchJobs/DOA.BatchJobs.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/sdk:8.0
WORKDIR /app
COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "DOA.BatchJobs.dll"]
